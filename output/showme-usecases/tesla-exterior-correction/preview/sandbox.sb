(version 1)
(deny default)
(allow process-fork)
(allow process-exec (literal "/Applications/Blender.app/Contents/MacOS/Blender"))
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow iokit-open (iokit-user-client-class "IOSurfaceRootUserClient")
                  (iokit-user-client-class "AGXDeviceUserClient"))
(allow ipc-posix-shm-read-data (ipc-posix-name "apple.shm.notification_center"))
(allow file-read-metadata)
(allow file-map-executable)
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/Library") (subpath "/private/var/db") (subpath "/Applications/Blender.app") (subpath "/Users/ramyamanchikanti/workplace/product-understanding/output/showme-usecases/tesla-exterior-correction/preview") (literal "/") (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random"))
(allow file-write* (subpath "/Users/ramyamanchikanti/workplace/product-understanding/output/showme-usecases/tesla-exterior-correction/preview") (literal "/dev/null"))
