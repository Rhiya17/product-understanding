  "gaps": [
    {
      "gap_id": "gap_tmy_official_trunk_linear_1",
      "kind": "SOURCE_MISSING",
      "waives": [],
      "reason": "Tesla publishes no linear rear-trunk dimensions (opening width/height, floor length, width between wheel arches, floor-to-shelf/headliner height, sub-trunk L x W x depth) for the 2025+ body in any vault source (manual live HTML, Dec-2025 PDF, tesla.com, shop). trunk_linear_measurements is covered only by third-party measurements (12365auto, d1ev, OeAMTC/ADAC) with undefined measurement points.",
      "closes_when": "A Tesla source (manual, Collision Repair text page, or spec sheet) states trimmed opening and floor dimensions, or a tape-and-photo measurement of a 2026 US Model Y and Premium is added to the vault with a defined method."
    },
    {
      "gap_id": "gap_tmy_collision_datum_1",
      "kind": "SOURCE_MISSING",
      "waives": [],
      "reason": "Collision Repair rear-body datum distances (1217-1223, 916-926, 795-805 mm) exist only as labels in an image capture (geometry/collision-manual-2025-rear-body-measurements-capture.png); src_brm2025_dimensional_specs_page has no local text file. The work order allows these only if quotable from a text source, so they are not extracted. They are body-in-white hole-to-hole distances, not opening sizes.",
      "closes_when": "A text capture of the Collision Repair 'Dimensional Specifications' page is added to the vault."
    },
    {
      "gap_id": "gap_tmy_seat_mech_trim_1",
      "kind": "UNDERIVABLE",
      "waives": [],
      "reason": "The manual marks both second-row methods 'If Equipped' (power switches; release straps) without naming trims. The vault's trim mapping (specs.md §4: Standard = straps, Premium/Performance = power) is a compiler's inference, not a verbatim Tesla statement, so STEP claims carry the equipment condition rather than a trim.",
      "closes_when": "A Tesla source (configurator feature list, trim spec page, or manual) states which trims have power-fold vs strap-release second-row seats."
    },
    {
      "gap_id": "gap_tmy_frunk_variant_trim_1",
      "kind": "UNDERIVABLE",
      "waives": [],
      "reason": "The manual distinguishes two frunk variants by tow-eye position (side wall: sealed, 110 lb; bottom: unsealed, 65 lb) but does not say which trims or production builds have which.",
      "closes_when": "A Tesla source maps frunk variant to trim/build, or a per-trim photo of the frunk tow-eye position is added."
    },
    {
      "gap_id": "gap_tmy_perf_spec_panel_1",
      "kind": "SOURCE_MISSING",
      "waives": [],
      "reason": "The tesla.com Performance specs panel was not captured (specs.md §1), so spec-page trim-identity claims (seating, displays, wheels, cargo headline, ground clearance) cover Model Y and Premium only. Performance dimensions come from the live manual only (not in the Dec-2025 PDF).",
      "closes_when": "The Performance spec panel is captured into specs.md."
    },
    {
      "gap_id": "gap_tmy_gvwr_value_1",
      "kind": "SOURCE_MISSING",
      "waives": [],
      "reason": "No numeric GVWR, GAWR, or occupant+cargo capacity for any US trim is in the vault; the manual points to per-vehicle door-pillar labels. Only the EU ADAC test car's payload (533 kg measured) is available.",
      "closes_when": "A photo or transcription of the Tire and Loading Information / Vehicle Certification labels for each US trim is added."
    },
    {
      "gap_id": "gap_tmy_seatback_angle_1",
      "kind": "UNDERIVABLE",
      "waives": [],
      "reason": "No source gives second-row seatback angles (upright, the four strap recline positions, or power-recline range). The manual gives only 'one of the four recline positions'; d1ev says the angle is not much changed from legacy.",
      "closes_when": "A measured or published second-row seatback angle for the 2025+ body is added."
    },
    {
      "gap_id": "gap_tmy_us_load_lip_1",
      "kind": "SOURCE_MISSING",
      "waives": [],
      "reason": "The only 2025+ load-lip height is ADAC's 68 cm for an EU Maximum Range RWD on 20-inch tyres; no US-trim load-lip height (and no laden/unladen state) is in the vault. Laden ground clearance also conflicts between manual editions for Premium.",
      "closes_when": "A measured load-lip height for US Model Y and Premium/Performance (with load state) is added."
    },
    {
      "gap_id": "gap_tmy_videos_1",
      "kind": "UNDERIVABLE",
      "waives": [],
      "reason": "The only downloaded Tesla video shows the legacy 2020-2024 interior (seat-fold handles, trunk trim), and the YouTube/frunk videos are URL-only. No video-bound claims were written; procedures are bound to manual text only.",
      "closes_when": "A Tesla-hosted 2025+ video of liftgate operation and second-row folding is added to the vault."
    }
  ]
}